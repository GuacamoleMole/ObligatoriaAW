<!DOCTYPE html>
<html>
    <head>
        <title>Error</title>
        <meta charset="UTF-8">
        <link rel="icon" type="image/x-icon" href="/imagen/logo?v=<%= Date.now() %>">
        <link rel="stylesheet" href="/stylesheets/style.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">  
    </head>
    <body>
        <div class="container mt-5">
            <h1 class="tituloError text-center">Error <%= status %></h1>
            <h2 class="subtituloError text-center"><%= mensaje %></h2>
            <div class="contenedorVolverHome text-center mt-5">
                <a href="/" class="volverHome">Volver a Home</a>
            </div>
            <div class="container contenedorMsgError">
                <p>Se ha producido el siguiente error:</p>
            <pre><%= pila %></pre>
            </div>
        </div>
