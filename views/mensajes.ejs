<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Mensajes</title>
        <link rel="stylesheet" href="/stylesheets/style.css">
        <link rel="icon" type="image/x-icon" href="/imagen/logo?v=<%= Date.now() %>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js" integrity="sha384-BBtl+eGJRgqQAUMxJ7pMwbEyER4l1g+O15P+16Ep7Q9Q+zqX6gSbd85u4mG4QzX+" crossorigin="anonymous"></script>
        <script src="https://code.jquery.com/jquery-3.6.0.js"></script>
        <script src="/javascript/validacionJQuery.js"></script>
    </head>
    <body>
        <!-- En el header, pasarle el email para saber si está o no logeado el usuario -->
        <%- include("header", {ses: datos.session}) %> <!-- subplantilla -->
        <!-- Estos datos serán tomados de la base de datos y recibidos como parámetros -->
        <div class="container mt-5">
            <h1>Bandeja de mensajes</h1>
            <% if (datos.session.validado === 0) { %> 
                <div class="alert alert-warning" role="alert">
                    <p>Para poder enviar mensajes a otros usuarios, debes esperar a que un administrador valide tu cuenta.</p>
                </div>
            <% } else { %>
                <button class="btn btn-primary mb-2" data-bs-toggle="modal" data-bs-target="#modalNuevoMensajeFacultad" >+ Mensaje a la Facultad</button>
                <% if (datos.session.rol === "admin") { %>
                    <button class="btn btn-primary mb-2" data-bs-toggle="modal" data-bs-target="#modalNuevoMensajeOrganizacion">+ Mensaje a la Organización</button>
                <% } %>
                
                <% if (datos.mensajes.length === 0) { %>
                    <div class="alert alert-info" role="alert">
                        No tienes ningún mensaje
                    </div>
                <% } else { %>
                    <% datos.mensajes.forEach(function (mensaje) { %>
                        <div class="mensajeContainer">
                            <div class="row headerMensaje">
                                <span><%= mensaje.nombre %> <%= mensaje.apellidos %></span>
                                <p class="emailMensaje"><%= mensaje.email %></p>
                            </div>
                            <div class="row asuntoMensaje">
                                <p><%= mensaje.asunto %></p>
                            </div>
                            <div class=" row contenidoMensaje">
                                <p><%= mensaje.contenido %></p>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            <% } %>
        </div>

        <!-- Modal de envío de mensaje a algún miembro de la facultad -->
        <div class="modal fade" id="modalNuevoMensajeFacultad" data-bs-backdrop="static" tabindex="-1" aria-labelledby="modalNuevoMensajeFacultad" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">Envía un mensaje a algún miembro de tu facultad</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form method="POST" action="/mensajes/enviarFacultad">
                            <div class="form-group">
                                <label for="emailDestinatarioFacultad" class="col-form-label">Destinatario:</label>
                                <select class="form-select" id="emailDestinatarioFacultad" name="emailDestinatarioFacultad" required>
                                    <option value="" selected>Selecciona un destinatario</option>
                                    <% datos.usuariosFacultad.forEach(function(usuario) { %>
                                        <option value="<%= usuario.email %>"><%= usuario.email %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="asuntoFacultad" class="col-form-label">Asunto:</label>
                                <input type="text" class="form-control" id="asuntoFacultad" name="asuntoFacultad" required>
                            </div>
                            <div class="form-group">
                                <label for="mensajeFacultad" class="col-form-label">Mensaje:</label>
                                <textarea class="form-control" rows="5" id="mensajeFacultad" name="mensajeFacultad" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary mt-3">Enviar mensaje</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal de envío de mensaje a algún miembro de la Organizacion -->
        <div class="modal fade" id="modalNuevoMensajeOrganizacion" data-bs-backdrop="static" tabindex="-1" aria-labelledby="modalNuevoMensajeOrganizacion" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">Envía un mensaje a algún miembro de tu organizacion</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form method="POST" action="/mensajes/enviarOrganizacion">
                            <div class="form-group">
                                <label for="emailDestinatarioOrganizacion" class="col-form-label">Destinatario:</label>
                                <select class="form-select" id="emailDestinatarioOrganizacion" name="emailDestinatarioOrganizacion" required>
                                    <option value="" selected>Selecciona un destinatario</option>
                                    <% datos.usuariosOrganizacion.forEach(function(usuario) { %>
                                        <option value="<%= usuario.email %>"><%= usuario.email %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="asuntoOrganizacion" class="col-form-label">Asunto:</label>
                                <input type="text" class="form-control" id="asuntoOrganizacion" name="asuntoOrganizacion" required>
                            </div>
                            <div class="form-group">
                                <label for="mensajeOrganizacion" class="col-form-label">Mensaje:</label>
                                <textarea class="form-control" rows="5" id="mensajeOrganizacion" name="mensajeOrganizacion" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary mt-3">Enviar mensaje</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <%- include("footer", {conf: datos.conf}) %>
    </body>
</html>