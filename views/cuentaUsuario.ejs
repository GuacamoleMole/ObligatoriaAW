<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Cuenta de Usuario</title>
        <link rel="stylesheet" href="/stylesheets/style.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js" integrity="sha384-BBtl+eGJRgqQAUMxJ7pMwbEyER4l1g+O15P+16Ep7Q9Q+zqX6gSbd85u4mG4QzX+" crossorigin="anonymous"></script>
    </head>
    <body>
        <!-- En el header, pasarle el email para saber si está o no logeado el usuario -->
        <%- include("header", {ses: datos.session}) %> <!-- subplantilla -->
        <!-- Estos datos serán tomados de la base de datos y recibidos como parámetros -->
        <div class="container mt-5">
            <h1 class="tituloCuentaUsuario">Datos de la cuenta de <span class="tituloNombreUsuario"><%= datos.email %></span></h1>
            <div class="datosUsuario">
                <img src="/images/avatarPredeterminado.jpg" alt="Imagen de portada instalaciones" class="avatarUsuario">
                <div class="datosTexto">
                    <div class="row">
                        <div class="col-md-6">
                            <p><span class="campoUsuario">Nombre: </span> <span class="infoUsuario"><%= datos.nombre %></span></p>
                        </div>
                        <div class="col-md-6">
                            <p><span class="campoUsuario">Apellidos: </span><span class="infoUsuario"><%= datos.apellidos %></span></p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <p><span class="campoUsuario">Facultad: </span><span class="infoUsuario">Facultad de <%= datos.facultad %></span></p>
                        </div>
                        <div class="col-md-6">
                            <p><span class="campoUsuario">Rol: </span><span class="infoUsuario"><%= datos.rol%></span></p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <p><span class="campoUsuario">Curso: </span><span class="infoUsuario"><%= datos.curso %>º</span></p>
                        </div>
                        <div class="col-md-6">
                            <p><span class="campoUsuario">Grupo: </span><span class="infoUsuario"><%= datos.grupo %></span></p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <p><span class="campoUsuario">Correo Electrónico: </span><span class="infoUsuario"><%= datos.email %></span></p>
                        </div>
                        <div class="col-md-6">
                            <p><span class="campoUsuario">Validado: </span><span class="infoUsuario"><%= datos.vali %></span></p>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
        <% if(datos.rol === 'admin' && datos.session !== undefined) { %>
            <a href="/usuario/admin/pendientes" class="btn btn-success">Usuarios pendientes</a>
            <a href="/usuario/admin/confSistema" class="btn btn-success">Configuración sistema</a>
            <a href="/usuario/admin/crearInstalacion" class="btn btn-success">Crear Instalación</a>
            <a href="/usuario/admin/historial" class="btn btn-success">Historial reservas</a>
            <a href="/usuario/admin/hacerAdmin" class="btn btn-success">Hacer administrador</a>

        <% }; %>
        <%- include("footer") %>
        <script src="https://code.jquery.com/jquery-3.6.0.js"></script>
    </body>
</html>