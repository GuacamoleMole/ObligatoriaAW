<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Iniciar Sesión</title>
        <link rel="stylesheet" href="/stylesheets/style.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js" integrity="sha384-BBtl+eGJRgqQAUMxJ7pMwbEyER4l1g+O15P+16Ep7Q9Q+zqX6gSbd85u4mG4QzX+" crossorigin="anonymous"></script>
        <script src="https://code.jquery.com/jquery-3.6.0.js"></script>
        <script src="javascript/validacionJQuery.js"></script>
    </head>
    <body>
        <!-- En el header, pasarle el email para saber si está o no logeado el usuario -->
        <%- include("header") %> <!-- subplantilla -->
        <!-- Estos datos serán tomados de la base de datos y recibidos como parámetros -->
        <div class="container mt-5">
            <h1>Datos de la cuenta de <%= id %></h1>
            <div class="datosUsuario">
                <img src="/images/avatarPredeterminado.jpg" alt="Imagen de portada instalaciones" class="avatarUsuario">
                <div class="datosTexto">
                    <div class="row">
                        <div class="col-md-6">
                            <p><span class="campoUsuario">Nombre: </span> <span class="infoUsuario">Manuel</span></p>
                        </div>
                        <div class="col-md-6">
                            <p><span class="campoUsuario">Apellidos: </span><span class="infoUsuario">Sánchez Martínez</span></p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <p><span class="campoUsuario">Facultad: </span><span class="infoUsuario">Facultad de Enfermería, Fisioterapia y Podología</span></p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <p><span class="campoUsuario">Curso: </span><span class="infoUsuario">1º</span></p>
                        </div>
                        <div class="col-md-6">
                            <p><span class="campoUsuario">Grupo: </span><span class="infoUsuario">B</span></p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <p><span class="campoUsuario">Correo Electrónico: </span><span class="infoUsuario">msanm@ucm.es</span></p>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>

        <%- include("footer") %>
    </body>
</html>