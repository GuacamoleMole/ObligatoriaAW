<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Iniciar Sesión</title>
        <link rel="stylesheet" href="/stylesheets/style.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js" integrity="sha384-BBtl+eGJRgqQAUMxJ7pMwbEyER4l1g+O15P+16Ep7Q9Q+zqX6gSbd85u4mG4QzX+" crossorigin="anonymous"></script>
    </head>
    <body>
        <% if (errores.length > 0) { %>
            <div class="alert alert-danger" role="alert">
                La información introducida no es correcta:
                <ul>
                    <% errores.forEach(function(error) { %>
                        <li><%= error.msg %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>
        
        <div class="container mt-5">
        <h2 class="mb-4">Iniciar Sesión</h2>
        <form method="POST" action="/usuario/login" >
            <!-- Campo Correo Electrónico -->
            <div class="mb-3">
            <label for="correo" class="form-label">Correo Electrónico:</label>
            <input type="email" class="form-control" id="email" name="email" required>
            <span id="errorEmail" class="campoIncorrecto"></span> 
            </div>

            <!-- Campo Contraseña -->
            <div class="mb-3">
            <label for="contrasena" class="form-label">Contraseña:</label>
            <input type="password" class="form-control" id="contrasena" name="contrasena" required>
            <span id="errorContrasena" class="campoIncorrecto"></span> 
            </div>

            <!-- Botón de Iniciar Sesión -->
            <button type="submit" class="btn btn-primary">Iniciar Sesión</button>
             <!-- Botón de Registro -->
             <a href="/usuario/registro" class="btn btn-success">No tengo cuenta</a>
        </form>
        </div>
        <script src="https://code.jquery.com/jquery-3.6.0.js"></script>
        <script src="/javascript/validacionJQuery.js"></script>
    </body>
</html>